<UserControl
    x:Class="VisionMaven.Modules.Algorithm.Views.AlgorithmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:VisionMaven.Modules.Shared.Views;assembly=VisionMaven.Modules.Shared"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitleText}" Text="算子类别" />
                <TreeView
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}">
                    <TreeViewItem
                        Header="图像处理"
                        IsExpanded="True"
                        ItemsSource="{Binding Groups}">
                        <TreeViewItem.ItemTemplate>
                            <DataTemplate>
                                <TreeViewItem
                                    Header="{Binding Title}"
                                    IsExpanded="True"
                                    ItemsSource="{Binding Operators}">
                                    <TreeViewItem.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Padding="2"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnOperatorSelected"
                                                Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </TreeViewItem.ItemTemplate>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                </TreeView>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldLabelText}" Text="{Binding SourcePath}" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitleText}" Text="参数" />
                <shared:ParameterEditorView DataContext="{Binding Editor}" />
            </DockPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="无图像"
                    Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
