<UserControl
    x:Class="VisionMaven.Modules.Home.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <!-- 实时画面 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" Margin="0,0,0,8" ItemsSource="{Binding Stations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                <TextBlock Text="{Binding Summary}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}">
                <Grid>
                    <Image
                        Margin="2"
                        Source="{Binding PreviewImage}"
                        Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="无画面"
                        Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PanelTitleText}" Text="最近检测记录" />
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding RecentRecords}"
                        RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding InspectedAt, StringFormat=HH:mm:ss}"
                                Header="时间" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding StationId}"
                                Header="工位" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Result, Converter={StaticResource EnumDisplay}}"
                                Header="判定" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Score, StringFormat=F3}"
                                Header="分数" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding ElapsedMs, StringFormat=F1}"
                                Header="耗时(ms)" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 指标 -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelTitleText}" Text="当前工位" />
                    <TextBlock
                        FontSize="{StaticResource BodyFontSize}"
                        Text="{Binding SelectedStation.Name, FallbackValue=-}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldLabelText}" Text="状态" />
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding SelectedStation.StateText, FallbackValue=-}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldLabelText}" Text="节拍" />
                    <TextBlock Style="{StaticResource MetricText}" Text="{Binding SelectedStation.CycleText, FallbackValue=-}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldLabelText}" Text="良率" />
                    <TextBlock Style="{StaticResource MetricText}" Text="{Binding SelectedStation.YieldText, FallbackValue=-}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource FieldLabelText}" Text="累计 OK / NG" />
                    <TextBlock Style="{StaticResource MetricText}" Text="{Binding SelectedStation.Summary, FallbackValue=-}" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelTitleText}" Text="工位与绑定" />
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Bindings}"
                        MaxHeight="240"
                        RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding StationId}"
                                Header="工位" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Cameras}"
                                Header="相机" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Devices}"
                                Header="设备" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FlowId}"
                                Header="流程" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 报警列表 -->
        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelTitleText}" Text="未确认报警" />
                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Alarms}"
                    RowHeight="22">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Time}"
                            Header="时间" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding StationId}"
                            Header="工位" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Code}"
                            Header="代码" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Message}"
                            Header="内容" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding AckText}"
                            Header="确认" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
