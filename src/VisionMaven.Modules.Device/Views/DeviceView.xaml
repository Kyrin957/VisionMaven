<UserControl
    x:Class="VisionMaven.Modules.Device.Views.DeviceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:VisionMaven.Modules.Shared.Views;assembly=VisionMaven.Modules.Shared"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <TabControl
            Grid.Column="0"
            ItemsSource="{Binding Tabs}"
            SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding Devices}"
                        RowHeight="24"
                        SelectedItem="{Binding DataContext.SelectedDevice, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding DeviceId}"
                                Header="标识" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding DriverKey}"
                                Header="驱动" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Enabled}"
                                Header="启用" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding StateText}"
                                Header="状态" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Message}"
                                Header="信息" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitleText}" Text="驱动连接参数" />
                <shared:ParameterEditorView DataContext="{Binding ConnectionEditor}" />
            </DockPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PanelTitleText}" Text="实时预览" />
                <Grid Grid.Row="1">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="无画面"
                        Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
