<Window
    x:Class="VisionMaven.App.Views.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    Title="修改密码"
    Width="400"
    Height="290"
    Background="{StaticResource BackgroundBrush}"
    FontFamily="{StaticResource PrimaryFontFamily}"
    FontSize="{StaticResource BodyFontSize}"
    Foreground="{StaticResource TextPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Border BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontSize="{StaticResource SubtitleFontSize}"
                FontWeight="SemiBold"
                Text="修改密码" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelText}" Text="当前密码" />
                <PasswordBox
                    x:Name="CurrentPasswordInput"
                    Grid.Column="1"
                    Height="26"
                    VerticalContentAlignment="Center"
                    PasswordChanged="OnCurrentPasswordChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelText}" Text="新密码" />
                <PasswordBox
                    x:Name="NewPasswordInput"
                    Grid.Column="1"
                    Height="26"
                    VerticalContentAlignment="Center"
                    PasswordChanged="OnNewPasswordChanged" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelText}" Text="确认新密码" />
                <PasswordBox
                    x:Name="ConfirmPasswordInput"
                    Grid.Column="1"
                    Height="26"
                    VerticalContentAlignment="Center"
                    PasswordChanged="OnConfirmPasswordChanged" />
            </Grid>

            <TextBlock
                Grid.Row="4"
                Margin="0,0,0,6"
                Foreground="{StaticResource DangerBrush}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel
                Grid.Row="6"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Command="{Binding SubmitCommand}"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource ActionButtonPrimary}" />
                <Button
                    Click="OnCancelClick"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
