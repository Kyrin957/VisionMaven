    xmlns:conv="clr-namespace:VisionMaven.App.Converters">

    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:BooleanToDoubleConverter x:Key="BoolToDouble" />
    <conv:BooleanToGridLengthConverter x:Key="BoolToGridLength" />
    <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
    <conv:StateToBrushConverter x:Key="StateToBrush" />
    <conv:EnumDisplayConverter x:Key="EnumDisplay" />

</ResourceDictionary>
