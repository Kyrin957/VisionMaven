<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 设计令牌，见开发文档 [5.6] -->
    <Color x:Key="PrimaryColor">#FF1F6FEB</Color>
    <Color x:Key="SuccessColor">#FF3FB950</Color>
    <Color x:Key="WarningColor">#FFD29922</Color>
    <Color x:Key="DangerColor">#FFF85149</Color>
    <Color x:Key="InfoColor">#FF58A6FF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF1F6FEB" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF388BFD" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#FF58A6FF" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1A1D21" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF22262B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2B3036" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FF16181B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8B949E" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD29922" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF85149" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF58A6FF" />

    <SolidColorBrush x:Key="BorderBrushToken" Color="#FF30363D" />

    <FontFamily x:Key="PrimaryFontFamily">Microsoft YaHei UI, Segoe UI, Source Han Sans SC</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="TitleFontSize">20</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">15</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>

    <sys:Double x:Key="HeaderRowHeight">36</sys:Double>
    <sys:Double x:Key="ActionBarHeight">40</sys:Double>
    <sys:Double x:Key="StatusBarHeight">26</sys:Double>
    <sys:Double x:Key="NavExpandedWidth">200</sys:Double>
    <sys:Double x:Key="NavCollapsedWidth">48</sys:Double>
    <sys:Double x:Key="LogBarHeight">140</sys:Double>
    <sys:Double x:Key="LogBarCollapsedHeight">28</sys:Double>

</ResourceDictionary>
